{
  "name": "neuroviz",
  "version": "2.33.0",
  "description": "Interactive Neural Network Decision Boundary Visualiser - Hexagonal Architecture Demo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report tests/reports"
  },
  "keywords": [
    "neural-network",
    "visualisation",
    "tensorflow",
    "d3",
    "hexagonal-architecture"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@tensorflow/tfjs": "^4.21.0",
    "d3": "^7.9.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.6.0",
    "@types/three": "^0.181.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "canvas": "^3.2.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.2.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.15",
    "semantic-release": "^25.0.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^6.0.2",
    "vite": "^6.0.1",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "form-data": "^4.0.6"
  }
}
